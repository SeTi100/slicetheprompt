{
  "mcpServers": {
    "slicetheprompt": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PROJECT_DIR:-.}",
        "--frozen",
        "--quiet",
        "slicetheprompt-mcp"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      },
      "timeout": 900000
    }
  }
}
